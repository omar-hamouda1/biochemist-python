# ─── Molecular Dynamics — Large Files ──────────────────────────────────
*.dcd
*.nc
*.trr
*.xtc

# ─── Compressed Archives ──────────────────────────────────────────────
*.zip
*.tar.gz
*.tar.bz2

# ─── AMBER / OpenMM State & Parameter Files ──────────────────────────
*.xml
*.inpcrd
*.prmtop
*.frcmod
*.pqr

# ─── Docking — Generated Files ────────────────────────────────────────
# Input PDBQT (can be regenerated from SDF with Open Babel)
docking/ligands/*.pdbqt
docking/receptor/*.pdbqt

# Output PDBQT (docking results — regenerated by running Smina)
*_out.pdbqt

# ─── MD — Large Generated PDB Files ──────────────────────────────────
# These solvated system PDBs are ~2 MB each and can be regenerated
md/preparation/system.pdb
md/preparation/minimized.pdb
md/preparation/equilibrated.pdb
md/preparation/protein_fixed.pdb
md/colab_workshop/01_md_simulation/*/system.pdb
md/colab_workshop/01_md_simulation/*/minimized.pdb
md/colab_workshop/01_md_simulation/*/equilibrated.pdb
md/colab_workshop/01_md_simulation/*/final.pdb
md/colab_workshop/01_md_simulation/*/*.pdb
md/colab_workshop/02_analysis/complex.pdb
md/colab_workshop/backup_zips/

# ─── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.env
.venv/

# ─── Jupyter ─────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ─── IDE ─────────────────────────────────────────────────────────────
.vscode/
.idea/

# ─── OS ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Logs ────────────────────────────────────────────────────────────
*.log
*.error.log

# ─── Backup Folders ───
src_backup/
scripts_backup/
*_backup/
*.bak

# Generated ProLIF pose files
docking/results/fixed/*.sdf

# Docking provenance sidecars (generated locally; summarized in the provenance manifest)
*.pdbqt.provenance.json
